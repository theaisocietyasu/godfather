# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.

# --- MongoDB ---
# Used by both backend and frontend. The compose file defaults this to the
# bundled mongo service; override only if pointing at an external cluster.
MONGODB_URI=mongodb://mongo:27017/Godfather

# --- RunPod ---
RUNPOD_API_KEY=your-runpod-api-key

# --- Discord Bot (backend + frontend OAuth) ---
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-guild-id
ADMIN_ROLE_ID=your-discord-admin-role-id
DISCORD_CLIENT_ID=your-discord-oauth-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret

# --- Auth ---
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=https://admin.ais-asu.com

# --- Frontend ---
NEXT_PUBLIC_APP_URL=https://admin.ais-asu.com

# --- Logging ---
LOG_LEVEL=INFO
