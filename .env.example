# Copy to .env and fill in real values. .env is gitignored; never commit it.
# docker compose reads this file and passes each value to the service that needs it.

# --- Shared by backend and frontend ---
# Signs the API tokens the frontend issues and the backend checks. At least 32 characters.
# Generate one with: openssl rand -hex 32
GODFATHER_TOKEN_SECRET=

# --- Backend ---
RUNPOD_API_KEY=
DISCORD_BOT_TOKEN=
# Right-click the server / role in Discord (Developer Mode on) and Copy ID
DISCORD_GUILD_ID=
ADMIN_ROLE_ID=
# Leave as-is to use the mongo container from docker-compose.yml
MONGODB_URI=mongodb://mongo:27017/Godfather
LOG_LEVEL=INFO

# --- Frontend (Discord login) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=
# Public URL of the portal, no trailing slash
NEXTAUTH_URL=https://admin.ais-asu.com

# --- Optional ---
# Image tag docker compose pulls (a release like 1.1.0, or latest)
GODFATHER_VERSION=latest
